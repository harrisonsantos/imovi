# =============================================================================
# .env.example — Variáveis de ambiente do Imovi
#
# NUNCA commite o .env.local com valores reais.
# Copie este arquivo como .env.local e preencha os valores.
# =============================================================================

# ---------------------------------------------------------------------------
# Banco de dados (Neon Postgres)
# Obtido após: bash scripts/setup-neon.sh
# Formato: postgresql://user:password@host/dbname?sslmode=require
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://neondb_owner:<password>@<host>.us-east-2.aws.neon.tech/neondb?sslmode=require

# ---------------------------------------------------------------------------
# Cloudflare
# Obtido em: https://dash.cloudflare.com/profile/api-tokens
# Permissões mínimas do token:
#   - Account > Cloudflare Pages: Edit
#   - Account > Workers Scripts: Edit
#   - Account > Account Settings: Read
#   - Account > Workers KV Storage: Edit
#   - Account > R2 Storage: Edit
# ---------------------------------------------------------------------------
# Token: OAuth via `wrangler login` (já configurado) OU API Token de CI
CLOUDFLARE_API_TOKEN=<seu-token-para-ci>
# Account ID confirmado via `wrangler whoami`
CLOUDFLARE_ACCOUNT_ID=f4000b2968b2834704aef648152c7dd4

# ---------------------------------------------------------------------------
# GitHub
# Token para criar repo + configurar secrets
# Scopes: repo, workflow
# ---------------------------------------------------------------------------
GITHUB_TOKEN=<seu-token>

# ---------------------------------------------------------------------------
# Neon (só necessário para scripts de setup/migration)
# Obtido em: https://console.neon.tech/app/settings/api-keys
# ---------------------------------------------------------------------------
NEON_API_KEY=<sua-key>

# ---------------------------------------------------------------------------
# Aplicação, autenticação e proteção anti-bot
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=development
GOOGLE_SITE_VERIFICATION=<token-do-search-console>
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=<gere-um-segredo-aleatorio-longo>
NEXT_PUBLIC_TURNSTILE_SITE_KEY=<site-key>
TURNSTILE_SECRET=<secret-key>
ESTIMATE_RATE_LIMIT_PER_MINUTE=10

# E-mail transacional: obrigatório em produção para verificar contas
RESEND_API_KEY=re_<chave-de-teste>
EMAIL_FROM=Imovi <auditoria@seu-dominio-verificado>
# Chave de cifragem Vista; use segredo aleatório com pelo menos 32 caracteres
VISTA_KEY_SECRET=<segredo-aleatorio>
# Adapter pago opcional para enriquecimento IPTU
INFOSIMPLES_TOKEN=<token-opcional>

# Smoke e recuperação; valores do ambiente staging/preview autorizado
WEB_URL=https://seu-preview.pages.dev
WORKER_URL=https://seu-worker-preview.workers.dev

# ---------------------------------------------------------------------------
# Assinaturas Stripe (use chaves e Price IDs de sandbox no desenvolvimento)
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_<chave>
STRIPE_WEBHOOK_SECRET=whsec_<segredo>
STRIPE_PRICE_AUDIT_ESSENCIAL=price_<id>
STRIPE_PRICE_AUDIT_PROFISSIONAL=price_<id>
STRIPE_PRICE_AUDIT_ESCALA=price_<id>

# ---------------------------------------------------------------------------
# Google AdSense — IDs são públicos; anúncios só carregam após consentimento
# ---------------------------------------------------------------------------
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-0000000000000000
NEXT_PUBLIC_ADSENSE_SLOT_HOME=0000000000
