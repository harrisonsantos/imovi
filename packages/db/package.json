{
  "name": "@imovi/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts",
    "./client": "./src/client.ts",
    "./estimates": "./src/repositories/estimates.ts"
  },
  "scripts": {
    "build": "tsc --build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --experimental-specifier-resolution=node ./src/migrate.ts",
    "seed:curitiba": "tsx seeds/curitiba.ts"
  },
  "dependencies": {
    "@imovi/shared": "workspace:*",
    "@neondatabase/serverless": "^0.10.3",
    "drizzle-orm": "^0.36.4",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.14",
    "@imovi/config": "workspace:*",
    "@types/node": "^22.10.0",
    "drizzle-kit": "^0.28.1",
    "eslint": "^9.17.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0",
    "vitest": "^2.1.8"
  }
}
