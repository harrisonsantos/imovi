{
  "name": "imovi",
  "version": "0.0.0",
  "private": true,
  "description": "Imovi — AVM (Automated Valuation Model) para imóveis no Brasil",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test --concurrency=1",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mjs,json,md,yml,yaml}\"",
    "validate": "pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "prettier": "^3.4.0",
    "turbo": "^2.3.0",
    "typescript": "^5.7.0"
  },
  "pnpm": {
    "overrides": {
      "vitest": "3.2.6",
      "drizzle-orm": "0.45.2",
      "adm-zip": "0.6.1",
      "protobufjs": "7.6.5",
      "postcss": "8.5.23",
      "nanoid@3": "3.3.18",
      "sharp": "0.35.5",
      "undici@7": "7.30.1",
      "vite": "6.4.4",
      "source-map-js": "1.2.2",
      "tinypool": "2.1.2",
      "better-auth": "1.7.7",
      "zod": "4.6.6",
      "glob@10": "10.5.0",
      "brace-expansion@2": "2.1.7",
      "brace-expansion@5": "5.0.12"
    }
  }
}
